{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "PORTFOLIO_KV", "id": "4af455192ea6431fb8073f7169160856" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-pulse",
      "database_id": "85666578-bc6f-4a65-86de-b07088a514f6"
    }
  ],
  "triggers": {
    "crons": [
      "5 6 * * *",
      "* 13-19 * * 2-6",
      "*/5 0-12,20-23 * * 2-6",
      "0 6,13,20 * * *"
    ]
  }
}
